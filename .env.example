# ==========================================
# TELEGRAM GUEST & MENTION REPLIER BOT CONFIG
# ==========================================

# Bot Tokens obtained from @BotFather (comma-separated for multi-bot cluster)
# e.g., 123456:ABC-DEF...,789012:GHI-JKL...
BOT_TOKENS=1234567890:AAExampleToken1,1234567891:AAExampleToken2,1234567892:AAExampleToken3

# Reply Mode:
# 'guest'  - Only reply to guest mentions (chats where the bot is not a member)
# 'member' - Only reply when mentioned in chats where the bot is a member
# 'both'   - Handle both guest mentions and member mentions (Recommended)
REPLY_MODE=both

# Parse Mode for formatted messages: 'HTML' or 'MarkdownV2'
PARSE_MODE=HTML

# Disable web page preview in replies: 'true' or 'false'
DISABLE_WEB_PAGE_PREVIEW=false

# Optional delay in seconds before sending reply (0 for instantaneous reply)
REPLY_DELAY=0.0

# Reply templates separated by '|||' (a random template will be picked for each reply)
# Available placeholders:
#   {first_name} - Sender's first name
#   {last_name}  - Sender's last name
#   {username}   - Sender's @username (or first name if username not set)
#   {bot_name}   - This bot's name
#   {date}       - Current date & time (UTC)
REPLY_TEMPLATES=🔥 <b>Special Update for {first_name}</b>!|||✨ Hello {first_name}, thanks for tagging {bot_name}! Check out our channel: @your_channel|||🚀 <b>Welcome {username}!</b> High-speed automated response enabled.

# Long Polling Configuration
POLL_TIMEOUT=25

# Webhook Server Configuration (used when running 'python main.py webhook')
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_URL_BASE=https://your-subdomain.ngrok-free.app
